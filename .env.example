AB_API_TOKEN=local-demo-token-change-me
AB_SOURCE=demo
AB_EMBEDDING_PROVIDER=hash
AB_DATA_DIR=.data
AB_DEMO_DIR=examples/demo-data
AB_UI_DIR=frontend/dist

# For real semantic retrieval, install .[inference] and select fastembed.
# Use a fresh AB_DATA_DIR when changing source, model, dimensions, or chunking.
# AB_EMBEDDING_PROVIDER=fastembed
# AB_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# AB_EMBEDDING_DIMENSIONS=384

# S3 uses the standard boto3 credential chain: IAM role, profile, or AWS_* variables.
# AB_SOURCE=s3
# AB_S3_ENDPOINT=https://s3.example.com
# AB_S3_BUCKET=knowledge
# AB_S3_PREFIX=docs/
# AB_S3_REGION=us-east-1
# AB_S3_ADDRESSING_STYLE=path
# AWS_PROFILE=your-profile
# AB_MAX_OBJECT_BYTES=20971520
# AB_MAX_OBJECTS=10000
# AB_CHUNK_CHARS=1600
# AB_CHUNK_OVERLAP=160
